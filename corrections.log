 "tokens": [50637, 2503, 291, 434, 4473, 264, 2596, 23918, 295, 428, 700, 5599, 597, 382, 321, 3264, 3071, 2962, 50905], "temperature": 0.0, "avg_logprob": -0.039168144892720344, "compression_ratio": 1.7864768683274022, "no_speech_prob": 4.081748827822196e-12}, {"id": 191, "seek": 112884, "start": 1139.6399999999999, "end": 1145.56, "text": " its hash and because the first hash changes the second commits hash changes all the way down the line", "tokens": [50905, 1080, 22019, 293, 570, 264, 700, 22019, 2962, 264, 1150, 48311, 22019, 2962, 439, 264, 636, 760, 264, 1622, 51201], "temperature": 0.0, "avg_logprob": -0.039168144892720344, "compression_ratio": 1.7864768683274022, "no_speech_prob": 4.081748827822196e-12}, {"id": 192, "seek": 112884, "start": 1145.56, "end": 1151.24, "text": " you're creating 10 brand new commits that contain the same changes but have completely different", "tokens": [51201, 291, 434, 4084, 1266, 3360, 777, 48311, 300, 5304, 264, 912, 2962, 457, 362, 2584, 819, 51485], "temperature": 0.0, "avg_logprob": -0.039168144892720344, "compression_ratio": 1.7864768683274022, "no_speech_prob": 4.081748827822196e-12}, {"id": 193, "seek": 112884, "start": 1151.24, "end": 1156.12, "text": " cryptographic identities infliction doesn't just explain this the curriculum makes you observe it", "tokens": [51485, 9844, 12295, 24239, 9922, 4105, 1177, 380, 445, 2903, 341, 264, 14302, 1669, 291, 11441, 309, 51729], "temperature": 0.0, "avg_logprob": -0.039168144892720344, "compression_ratio": 1.7864768683274022, "no_speech_prob": 4.081748827822196e-12}, {"id": 194, "seek": 115612, "start": 1156.12, "end": 1163.56, "text": " simultaneously using that hidden refs slash textbook namespace we discussed earlier fliction preserves", "tokens": [50365, 16561, 1228, 300, 7633, 1895, 82, 17330, 25591, 5288, 17940, 321, 7152, 3071, 932, 4105, 1183, 9054, 50737], "temperature": 0.0, "avg_logprob": -0.059290033705691074, "compression_ratio": 1.7608695652173914, "no_speech_pro